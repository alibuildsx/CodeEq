# ==============================================================================
# CodeEq Web Scanner — Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local web development or configure in Vercel:
#   cp .env.example .env.local
#
# GitHub Personal Access Token (Optional but recommended)
# CodeEq's public GitHub scanner works out-of-the-box without authentication,
# but is subject to GitHub's public IP rate limit (60 requests/hour).
# Providing a read-only GitHub token increases the rate limit to 5,000 requests/hour.
#
# NOTE: Only standard read permissions are needed. Never provide write/admin tokens.
# GITHUB_TOKEN is accessed exclusively on the server and is never exposed to client bundles.
GITHUB_TOKEN=
